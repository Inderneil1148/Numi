rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Lightweight connection testing document
    match /test/{testId} {
      allow get: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.keys().hasAll(['userId']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'currency', 'budget', 'theme', 'updatedAt']) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('theme' in data) || data.theme in ['system', 'light', 'dark']);
    }

    function isValidTransaction(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.keys().hasAll(['id', 'userId', 'type', 'amount', 'title', 'category', 'customTags', 'date', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'type', 'amount', 'title', 'category', 'customTags', 'date', 'time', 'note', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.type in ['expense', 'income'] &&
        data.amount is number && data.amount >= 0 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
        data.customTags is list && data.customTags.size() <= 20 &&
        data.date is string && data.date.size() <= 20 &&
        (!('time' in data) || (data.time is string && data.time.size() <= 10)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        data.createdAt is number;
    }

    function isValidTag(data, userId) {
      return data.userId == userId &&
        data.userId == request.auth.uid &&
        data.keys().hasAll(['id', 'userId', 'name', 'color', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'color', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 50 &&
        data.color is string && data.color.size() <= 30 &&
        data.createdAt is number;
    }

    // User profile and settings
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) &&
          isValidTransaction(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      }

      // User tags subcollection
      match /tags/{tagId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(tagId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(tagId) && isValidTag(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(tagId) &&
          isValidTag(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(tagId);
      }
    }
  }
}
